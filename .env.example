# Copy this file to .env and adjust values as needed.
# docker compose reads .env automatically.

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=****************

# Disable CrewAI interactive telemetry prompts (required for Docker).
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true

# --- Azure demo: API in the cloud, vision/matching/explanation stay local ---
# Set these on Azure App Service (Application settings). Run local_bridge on your
# machine and expose it with a tunnel (ngrok, Cloudflare Tunnel, etc.).
# LOCAL_BRIDGE_URL=https://<your-tunnel-host>   # no trailing slash; bridge root
# RESULT_CALLBACK_URL=https://<your-azure-app>.azurewebsites.net/internal/result-callback
# CALLBACK_TOKEN=<long-random-shared-secret>
# Optional: max seconds the bridge waits for routine.completed (local_bridge process)
# ROUTINE_WAIT_TIMEOUT_SECONDS=600
# On Azure (bridge-only), disable the in-API RabbitMQ consumer if you have no cloud broker:
# ENABLE_RABBIT_RESULT_CONSUMER=false